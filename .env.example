# Copy to .env (ignored) and provision private files; no credentials are included.
PATCHINGTON_IMAGE=sir-patchington:local
PATCHINGTON_CONFIG_FILE=./deploy/config.production.toml
PATCHINGTON_POSTGRES_PASSWORD_FILE=./.local/secrets/postgres-password
# Contents: postgresql+psycopg://patchington:<password>@postgres:5432/patchington
PATCHINGTON_DATABASE_URL_FILE=./.local/secrets/database-url
PATCHINGTON_WEBHOOK_SECRET_FILE=./.local/secrets/webhook-secret
PATCHINGTON_APPROVAL_SECRET_FILE=./.local/secrets/approval-secret
PATCHINGTON_READ_APP_ID=
PATCHINGTON_READ_APP_KEY_FILE=./.local/secrets/read-app.pem
PATCHINGTON_WRITE_APP_ID=
PATCHINGTON_WRITE_APP_KEY_FILE=./.local/secrets/write-app.pem
# Worker-only, operator-provisioned subscription authentication; never host HOME.
PATCHINGTON_CLAUDE_CREDENTIALS_FILE=./.local/secrets/claude-credentials.json
PATCHINGTON_DOCKER_CA_FILE=./.local/secrets/docker/ca.pem
PATCHINGTON_DOCKER_CERT_FILE=./.local/secrets/docker/cert.pem
PATCHINGTON_DOCKER_KEY_FILE=./.local/secrets/docker/key.pem
# Requires an independently secured rootless daemon with mTLS and a pinned image.
PATCHINGTON_DOCKER_HOST=tcp://127.0.0.1:2376
# Explicit consent is required at runtime. CI never sets this to 1.
PATCHINGTON_ALLOW_LIVE_MODEL=0
